# Copy to .env.local for local development. Never commit real values.
# In the cloud, these come from each cloud's secret manager via Terraform.

APP_NAME="30 Apps Template"
APP_URL=http://localhost:3000

DATABASE_URL=postgres://app:app@localhost:5432/app

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# demo | gemini | anthropic
AI_PROVIDER=demo
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_FALLBACK_TO_DEMO=true
# Embedding model for embed() (default gemini-embedding-2) and the timeout for every model call
AI_EMBED_MODEL=
AI_TIMEOUT_MS=20000

LOG_LEVEL=info

# Apply pending migrations when the server starts (used in the cloud)
MIGRATE_ON_START=false

# Optional, used by `pnpm db:seed` against a running app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
